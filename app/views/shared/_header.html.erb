<header class="bg-ash-nav border-b border-ash-border sticky top-0 z-40 backdrop-blur-md">
<div class="container mx-auto flex flex-wrap px-5 py-4 flex-col md:flex-row items-center">
  <h1 class="flex title-font items-center mb-4 md:mb-0">
    <%= link_to root_path, class: "flex items-center space-x-2" do %>
      <%= image_tag "https://cgm-production-images.s3.ap-northeast-1.amazonaws.com/default/cgm-logo.png", width: "36px" %>
      <span class="font-serif text-sm font-semibold tracking-wider text-ash-text">カタログギフトメーカー</span>
    <% end %>
  </h1>
  <ul class="md:ml-auto flex flex-wrap items-center gap-5 text-xs font-light text-ash-sub">
    <li><%= link_to "ギフトリスト一覧", gift_lists_path, class: "hover:text-ash-text transition-colors" %></li>
    <% if user_signed_in? %>
      <li>
        <%= link_to notifications_path, class: "relative flex items-center hover:text-ash-text transition-colors" do %>
          <i data-lucide="bell" class="w-4 h-4"></i>
          <% unread_count = current_user.notifications.unread.count %>
          <% if unread_count.positive? %>
            <span class="absolute -top-1.5 -right-1.5 w-3.5 h-3.5 rounded-full bg-clay text-white text-[9px] flex items-center justify-center"><%= unread_count %></span>
          <% end %>
        <% end %>
      </li>
    <% end %>
    <li><%= link_to "ログイン", new_user_session_path, class: "hover:text-ash-text transition-colors" if !user_signed_in? %></li>
    <li><%= link_to "ログアウト", destroy_user_session_path, class: "hover:text-ash-text transition-colors", data: { turbo_method: :delete } if user_signed_in? %></li>
    <li><%= link_to current_user.name, edit_user_registration_path, class: "font-serif text-ash-text hover:underline" if user_signed_in? %></li>
  </ul>
</div>
</header>
