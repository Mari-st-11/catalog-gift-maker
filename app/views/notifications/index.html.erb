<div class="container mx-auto px-5 py-10 text-center">
  <h1 class="text-xl font-bold mb-5">通知</h1>

  <% if @notifications.present? %>
    <div class="flex flex-col gap-3 w-full max-w-xl mx-auto">
      <% @notifications.each do |notification| %>
        <% gift_item = notification.gift_item %>
        <% gift_list = gift_item&.gift_list %>
        <div class="card bg-base-100 card-sm shadow-sm text-left">
          <div class="card-body">
            <% if gift_item && gift_list %>
              <p class="text-sm">
                <%= gift_list.recipient_name %>さんが「<%= gift_item.name %>」を選びました
              </p>
              <%= link_to "ギフトリストを見る", gift_list_path(gift_list), class: "link text-sm" %>
            <% else %>
              <p class="text-sm text-gray-500">対象のギフトは削除されています</p>
            <% end %>
            <p class="text-xs text-gray-400 mt-1"><%= l notification.created_at, format: :long %></p>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>通知はまだありません</p>
  <% end %>

  <div class="mt-10">
    <%= link_to "< ギフトリスト一覧へ戻る", gift_lists_path, class: "link" %>
  </div>
</div>
