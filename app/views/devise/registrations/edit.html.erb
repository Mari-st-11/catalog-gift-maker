<div class="container mx-auto px-5 py-10 text-center">
  <h1 class="text-xl font-bold mb-5">アカウント編集</h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
    <fieldset class="fieldset border-base-200 rounded-box w-xs border p-4 mx-auto">
      <% if resource.errors.any? %>
        <h3><i class="fa-solid fa-triangle-exclamation mr-2"></i>入力エラーがあります</h3>
        <% resource.errors.full_messages.each do |message| %>
          <li class="text-red-800"><%= message %></li>
        <% end %>
      <% end %>

      <label class="label">表示名</label>
      <div class="input">
        <%= f.text_field :name, autofocus: true %>
      </div>

      <label class="label">メールアドレス</label>
      <div class="input">
        <%= f.email_field :email, autocomplete: "email" %>
      </div>

      <button class="btn btn-neutral mt-4">
        <%= f.submit "更新する" %>
      </button>
    </fieldset>
  <% end %>

  <div class="mt-10 text-sm">
    <%= button_to "アカウントを削除する", registration_path(resource_name), data: { turbo_confirm: "本当に削除しますか？" }, method: :delete, class: "btn btn-outline btn-error btn-sm" %>
  </div>

  <div class="mt-6">
    <%= link_to "< 戻る", gift_lists_path, class: "link" %>
  </div>
</div>
