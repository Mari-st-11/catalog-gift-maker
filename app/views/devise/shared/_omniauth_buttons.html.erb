<% if devise_mapping.omniauthable? %>
  <% provider_labels = { "google_oauth2" => "Googleでログイン", "line" => "LINEでログイン" } %>
  <div class="w-xs mx-auto mt-6 flex flex-col gap-3">
    <% resource_class.omniauth_providers.each do |provider| %>
      <%= button_to provider_labels.fetch(provider.to_s, "#{OmniAuth::Utils.camelize(provider)}でログイン"),
          omniauth_authorize_path(resource_name, provider), method: :post, class: "btn btn-outline w-full", data: { turbo: false } %>
    <% end %>
  </div>
<% end %>
