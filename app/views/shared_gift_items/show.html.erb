<% content_for :head do %>
  <meta name="robots" content="noindex, nofollow">
<% end %>

<div class="bg-ash-bg min-h-screen">
  <header class="px-7 py-6 flex items-center border-b border-ash-border bg-gold-light/95 backdrop-blur-md sticky top-0 z-30">
    <%= link_to shared_gift_list_path(@gift_item.gift_list.public_token), class: "text-xs text-ash-sub hover:text-ash-text flex items-center space-x-1 font-serif" do %>
      <i data-lucide="chevron-left" class="w-4 h-4"></i>
      <span>カタログへ戻る</span>
    <% end %>
  </header>

  <div class="p-6 sm:p-7 max-w-md mx-auto space-y-5">
    <% if @gift_item.display_image_url.presence %>
      <div class="aspect-[4/3] bg-ash-bg overflow-hidden border border-ash-border">
        <%= image_tag @gift_item.display_image_url, class: "w-full h-full object-cover" %>
      </div>
    <% end %>

    <div class="space-y-2">
      <h1 class="font-serif text-base font-semibold leading-relaxed text-ash-text"><%= @gift_item.name %></h1>
      <p class="text-xs text-ash-sub leading-relaxed font-light pt-3 border-t border-ash-border">
        <%= safe_join(@gift_item.description.to_s.split("\n"), tag(:br)) %>
      </p>
    </div>

    <div class="p-4 bg-gold-light/60 border border-gold-border text-xs text-ash-text space-y-1">
      <div class="flex items-center space-x-1.5 text-gold-dark font-normal">
        <i data-lucide="shield-check" class="w-4 h-4 text-gold-dark"></i>
        <span class="tracking-wide">住所の入力は一切不要です</span>
      </div>
      <p class="leading-relaxed text-[11px] text-ash-sub font-light">
        選ぶと、贈り主様に「これに決めました」と連絡が届きます。発送先のご住所はLINEやお電話で直接お伝えいただけます。
      </p>
    </div>

    <% unless @gift_item.selected? || @gift_item.confirmed? %>
      <%= button_to choose_shared_gift_list_path(@gift_item.gift_list.public_token, gift_item_id: @gift_item.id),
          data: { turbo_confirm: "このプレゼントで#{@gift_item.gift_list.user.name}さんに通知していいですか？" },
          class: "w-full py-4 text-white font-serif text-xs tracking-widest shadow-md flex items-center justify-center space-x-2 btn-gold-subtle transition" do %>
        <i data-lucide="gift" class="w-4 h-4"></i>
        <span>これに決める</span>
      <% end %>
    <% end %>
  </div>
</div>
