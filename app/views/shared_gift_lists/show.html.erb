<% content_for :head do %>
  <meta name="robots" content="noindex, nofollow">
<% end %>

<div class="bg-ash-bg min-h-screen">
  <header class="px-7 py-6 flex justify-between items-center border-b border-gold-border/60 bg-gold-light/95 backdrop-blur-md sticky top-0 z-30">
    <span class="font-serif text-base font-semibold tracking-wider text-ash-text">Webカタログギフト</span>
    <span class="text-[11px] font-normal tracking-widest text-clay-dark font-serif">特別なおくりもの</span>
  </header>

  <% if @gift_items.any?(&:confirmed?) %>
    <div class="max-w-md mx-auto mt-4 px-6">
      <div class="bg-gold-light/60 p-5 border border-gold-border space-y-2">
        <div class="flex items-center space-x-2 text-gold-dark font-serif text-xs">
          <i data-lucide="bell" class="w-4 h-4"></i>
          <span>お知らせしました</span>
        </div>
        <p class="text-xs text-ash-sub font-light leading-relaxed">
          <%= @gift_list.user.name %>さんに選んだギフトをお知らせしました！ギフトが届くまでお待ちください。<br>
          選び直したい場合は直接<%= @gift_list.user.name %>さんにご連絡ください。
        </p>
      </div>
    </div>
  <% end %>

  <div class="bg-gradient-to-b from-gold-light via-gold-light/40 to-transparent pb-2">
    <div class="px-6 sm:px-7 pt-9 pb-3 space-y-9 max-w-md mx-auto">
      <article class="bg-white p-7 sm:p-8 pt-9 relative border border-ash-border shadow-[0_8px_28px_-8px_rgba(197,160,89,0.25)]">
        <div class="absolute top-2.5 left-2.5 w-2.5 h-2.5 border-t border-l border-gold"></div>
        <div class="absolute top-2.5 right-2.5 w-2.5 h-2.5 border-t border-r border-gold"></div>
        <div class="absolute bottom-2.5 left-2.5 w-2.5 h-2.5 border-b border-l border-gold"></div>
        <div class="absolute bottom-2.5 right-2.5 w-2.5 h-2.5 border-b border-r border-gold"></div>

        <div class="absolute -top-5 left-1/2 -translate-x-1/2 w-10 h-10 rounded-full bg-white border border-gold flex items-center justify-center shadow-[0_2px_10px_-2px_rgba(197,160,89,0.5)]">
          <i data-lucide="gift" class="w-4 h-4 text-gold-dark"></i>
        </div>

        <div class="space-y-6 relative z-10">
          <div class="flex justify-between items-center pb-4 border-b border-ash-border/70 text-xs text-ash-sub">
            <span class="flex items-center space-x-1.5 text-clay-dark font-normal">
              <i data-lucide="heart" class="w-3.5 h-3.5"></i>
              <span><%= @gift_list.purpose.presence || "ギフト" %></span>
            </span>
            <span class="font-serif text-ash-text font-normal">贈り主：<%= @gift_list.user.name %>より</span>
          </div>

          <h1 class="font-serif text-lg sm:text-xl font-bold leading-[1.8] text-ash-text tracking-wide pt-1">
            <%= @gift_list.recipient_name %>へ<br>心を込めて。
          </h1>

          <% if @gift_list.content? %>
            <p class="text-xs leading-[2.2] text-ash-sub font-light border-t border-ash-border/50 pt-4">
              <%= safe_join(@gift_list.content.split("\n"), tag(:br)) %>
            </p>
          <% end %>
        </div>
      </article>
    </div>
  </div>

  <div class="px-6 sm:px-7 pb-7 space-y-9 max-w-md mx-auto">
    <div class="space-y-1.5 text-center pt-2">
      <div class="flex items-center justify-center space-x-4">
        <div class="h-px w-8 bg-clay/40"></div>
        <span class="text-sm font-serif text-clay-dark tracking-widest">あなたへの贈りもの</span>
        <div class="h-px w-8 bg-clay/40"></div>
      </div>
      <p class="text-[11px] text-ash-sub font-light tracking-wide">お好きな商品を1つお選びいただけます</p>
    </div>

    <% if @gift_items.present? %>
      <div class="space-y-5">
        <% @gift_items.each do |gift_item| %>
          <%= render "gift_items/shared_gift_item", gift_item: gift_item %>
        <% end %>
      </div>
    <% else %>
      <p class="text-center text-ash-sub text-sm font-light py-6">登録されたギフトがありません</p>
    <% end %>

    <footer class="pt-8 pb-4 text-center border-t border-ash-border/70 space-y-3">
      <p class="text-[11px] text-ash-sub font-light leading-relaxed">
        ※選ぶと、贈り主様へお知らせが届きます。<br>当サービスでお名前やご住所を入力する必要はございません。
      </p>
      <p class="text-[10px] text-ash-sub/70 font-light">カタログギフトメーカー</p>
    </footer>
  </div>
</div>
