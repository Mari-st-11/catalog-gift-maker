<div class="bg-ash-bg min-h-[calc(100vh-200px)]">
  <header class="px-7 py-6 flex items-center border-b border-ash-border bg-white sticky top-0 z-30">
    <%= link_to gift_list_path(@gift_item.gift_list), class: "text-xs text-ash-sub hover:text-ash-text flex items-center space-x-1 font-serif" do %>
      <i data-lucide="chevron-left" class="w-4 h-4"></i>
      <span>一覧へ戻る</span>
    <% end %>
  </header>

  <div class="p-6 sm:p-7 max-w-md mx-auto space-y-5">
    <span class="text-[11px] text-ash-sub font-light block">
      <%= @gift_item.gift_list.recipient_name %>へ贈る <%= @gift_item.gift_list.purpose.presence || "ギフトリスト" %>
    </span>

    <% if @gift_item.image.url.presence %>
      <div class="aspect-[4/3] bg-white overflow-hidden border border-ash-border">
        <%= image_tag @gift_item.image.url, class: "w-full h-full object-cover" %>
      </div>
    <% end %>

    <div class="space-y-2">
      <h1 class="font-serif text-base font-semibold leading-relaxed text-ash-text"><%= @gift_item.name %></h1>
      <p class="text-xs text-ash-sub leading-relaxed font-light pt-3 border-t border-ash-border">
        <%= safe_join(@gift_item.description.to_s.split("\n"), tag(:br)) %>
      </p>
    </div>

    <% if @gift_item.url.present? %>
      <%= link_to @gift_item.url, target: "_blank", rel: "noopener",
          class: "w-full py-3 text-white font-serif text-xs tracking-widest shadow-md btn-gold-subtle transition flex items-center justify-center space-x-2" do %>
        <span>ギフトの購入ページを見る</span>
        <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
      <% end %>
    <% end %>

    <div class="flex justify-center gap-6 pt-2 text-xs">
      <%= link_to edit_gift_item_path(@gift_item), class: "text-ash-sub hover:text-ash-text flex items-center space-x-1 font-serif" do %>
        <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
        <span>編集</span>
      <% end %>
      <%= link_to gift_item_path(@gift_item), data: { turbo_method: :delete, turbo_confirm: "削除しますか？" },
          class: "text-clay-dark hover:underline flex items-center space-x-1 font-serif" do %>
        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
        <span>削除</span>
      <% end %>
    </div>
  </div>
</div>
