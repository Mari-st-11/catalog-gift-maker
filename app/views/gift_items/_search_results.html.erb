<% if keyword.present? && results.blank? %>
  <p class="text-sm mt-3">「<%= keyword %>」に一致する商品が見つかりませんでした。</p>
<% end %>

<div id="search_results_grid" class="grid grid-cols-2 gap-3 mt-3">
  <%= render partial: "search_result_card", collection: results, as: :result, locals: { gift_list: gift_list } if results.present? %>
</div>

<div id="search_results_more" class="mt-3">
  <%= render "search_more_button", keyword: keyword, gift_list: gift_list, page: 2 if results.present? %>
</div>
