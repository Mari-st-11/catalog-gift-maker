<% initial_tab ||= "search" %>
<div class="bg-white p-6 border border-ash-border space-y-5 text-left" data-controller="tabs">
  <% if gift_item.errors.any? %>
    <div class="text-clay-dark text-xs space-y-1 bg-clay-light border border-clay/40 p-3">
      <% gift_item.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="grid grid-cols-3 gap-1 bg-ash-bg p-1 border border-ash-border text-[11px]">
    <button type="button" data-tabs-target="tab" data-action="tabs#select" data-tabs-name-param="search"
      class="py-2 border font-serif text-center transition-colors flex items-center justify-center space-x-1
      <%= initial_tab == "search" ? "bg-white border-ash-border text-ash-text" : "border-transparent text-ash-sub" %>">
      <span class="w-3.5 h-3.5 rounded-full bg-[#BF0000] text-white text-[8px] font-bold flex items-center justify-center flex-shrink-0">R</span>
      <span class="w-3.5 h-3.5 rounded-full bg-[#FF0033] text-white text-[8px] font-bold flex items-center justify-center flex-shrink-0">Y</span>
      <span>検索</span>
    </button>
    <button type="button" data-tabs-target="tab" data-action="tabs#select" data-tabs-name-param="url"
      class="py-2 border font-serif text-center transition-colors
      <%= initial_tab == "url" ? "bg-white border-ash-border text-ash-text" : "border-transparent text-ash-sub" %>">URLで追加</button>
    <button type="button" data-tabs-target="tab" data-action="tabs#select" data-tabs-name-param="manual"
      class="py-2 border font-serif text-center transition-colors
      <%= initial_tab == "manual" ? "bg-white border-ash-border text-ash-text" : "border-transparent text-ash-sub" %>">自分で入力</button>
  </div>

  <div data-tabs-target="panel" data-tabs-name="search" class="space-y-3 <%= "hidden" unless initial_tab == "search" %>">
    <%= form_with url: search_gift_list_gift_items_path, method: :get, data: { turbo_stream: true } do |f| %>
      <div class="flex gap-2 text-xs">
        <%= f.text_field :keyword, placeholder: "キーワードを入力(例: コーヒーメーカー)",
            class: "flex-1 p-3 bg-ash-bg border border-ash-border focus:outline-none focus:border-gold text-ash-text" %>
        <button class="px-4 bg-ink hover:bg-ink-hover text-white font-serif text-xs tracking-wider transition">検索</button>
      </div>
    <% end %>
    <p class="text-[11px] text-ash-sub font-light">楽天市場・Yahoo!ショッピングから探せます</p>
    <div id="search_results" class="pt-2"></div>
  </div>

  <div data-tabs-target="panel" data-tabs-name="url" class="space-y-3 text-xs <%= "hidden" unless initial_tab == "url" %>">
    <p class="text-[11px] text-ash-sub font-light">Amazonやminne等の商品ページのリンクを貼ると、商品名や写真を自動で読み込みます</p>
    <%= form_with model: gift_item, url: gift_list_gift_items_path do |f| %>
      <%= f.url_field :url, placeholder: "https://〜",
          class: "w-full p-3 bg-ash-bg border border-ash-border focus:outline-none focus:border-gold text-ash-text" %>
      <button class="w-full py-2.5 mt-3 bg-ink hover:bg-ink-hover text-white font-serif transition">
        このURLから追加する
      </button>
    <% end %>
    <p class="text-[11px] text-ash-sub font-light">※現在、Amazonは商品データを取得できません</p>
  </div>

  <div data-tabs-target="panel" data-tabs-name="manual" class="space-y-3 text-xs <%= "hidden" unless initial_tab == "manual" %>">
    <p class="text-[11px] text-ash-sub font-light">お好きな画像を使って、個人ショップの商品なども登録できます</p>
    <%= form_with model: gift_item, url: gift_list_gift_items_path do |f| %>
      <div class="space-y-1.5">
        <label class="text-ash-text font-serif block">商品画像</label>
        <%= f.file_field :image, accept: "image/*", class: "text-xs" %>
      </div>
      <div class="space-y-1.5 mt-3">
        <label class="text-ash-text font-serif block">商品名</label>
        <%= f.text_field :name, placeholder: "コーヒーメーカー",
            class: "w-full p-2.5 bg-ash-bg border border-ash-border focus:outline-none focus:border-gold text-ash-text" %>
      </div>
      <div class="space-y-1.5 mt-3">
        <label class="text-ash-text font-serif block">商品説明</label>
        <%= f.text_area :description, rows: 3, placeholder: "電動ミル付きのコーヒーメーカーです",
            class: "w-full p-2.5 bg-ash-bg border border-ash-border focus:outline-none focus:border-gold text-ash-text" %>
      </div>
      <div class="space-y-1.5 mt-3">
        <label class="text-ash-text font-serif block">購入できるページのURL(任意)</label>
        <%= f.text_field :url, placeholder: "https://〜",
            class: "w-full p-2.5 bg-ash-bg border border-ash-border focus:outline-none focus:border-gold text-ash-text" %>
      </div>
      <button class="w-full py-2.5 mt-4 bg-ink hover:bg-ink-hover text-white font-serif transition">この商品を追加する</button>
    <% end %>
  </div>
</div>

<% if gift_items.present? %>
  <div class="bg-white p-6 border border-ash-border space-y-4 mt-6 text-left">
    <div class="flex justify-between items-center border-b border-ash-border/60 pb-3">
      <h3 class="font-serif text-xs font-medium text-ash-text tracking-wider">選択済みの商品(<%= gift_items.size %>点)</h3>
    </div>
    <div class="space-y-3 text-xs">
      <% gift_items.each_with_index do |item, index| %>
        <div class="p-3 border border-ash-border flex justify-between items-center">
          <span class="font-serif text-ash-text"><%= index + 1 %>. <%= item.name %></span>
          <div class="flex items-center space-x-3">
            <%= link_to "編集", edit_gift_item_path(item), class: "text-gold-dark hover:underline" %>
            <%= link_to "削除", gift_item_path(item), data: { turbo_method: :delete, turbo_confirm: "削除しますか？" }, class: "text-ash-sub hover:text-clay-dark" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<%= link_to edit_gift_list_path(gift_list), class: "w-full py-3.5 mt-6 text-white font-serif text-xs tracking-widest shadow-sm btn-gold-subtle transition flex items-center justify-center space-x-1.5" do %>
  <span>次へ：メッセージを書く</span>
  <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
<% end %>
