<% selected_item = gift_list.gift_items.find { |item| item.confirmed? || item.selected? } %>
<article class="bg-white p-6 border text-left space-y-4
  <%= gift_list.selected? ? 'border-gold/60 shadow-[0_2px_12px_-4px_rgba(197,160,89,0.1)]' : 'border-ash-border shadow-[0_2px_12px_-4px_rgba(0,0,0,0.02)]' %>
  <%= 'opacity-80' if gift_list.completed? %>">

  <div class="flex justify-between items-center pb-3 border-b border-ash-border/60 text-xs">
    <% if gift_list.selected? %>
      <span class="text-[11px] font-normal px-2.5 py-0.5 bg-gold-light text-gold-dark border border-gold-border font-serif">
        贈りものが決まりました
      </span>
    <% elsif gift_list.completed? %>
      <span class="text-[11px] font-light px-2.5 py-0.5 bg-zinc-100 text-zinc-600 border border-zinc-200 font-serif flex items-center space-x-1">
        <i data-lucide="check" class="w-3 h-3"></i>
        <span>プレゼント完了</span>
      </span>
    <% elsif gift_list.draft? %>
      <span class="text-[11px] font-light px-2.5 py-0.5 bg-ash-bg text-ash-sub border border-ash-border font-serif">
        作成中
      </span>
    <% else %>
      <span class="text-[11px] font-light px-2.5 py-0.5 bg-ash-bg text-ash-sub border border-ash-border font-serif">
        相手の選択待ち
      </span>
    <% end %>
    <span class="text-[11px] text-ash-sub font-light">作成日: <%= l gift_list.created_at.to_date, format: :long %></span>
  </div>

  <div class="space-y-1">
    <span class="text-[11px] text-ash-sub font-light">贈る相手: <%= gift_list.recipient_name %></span>
    <h2 class="font-serif text-base font-semibold text-ash-text">
      <%= link_to (gift_list.purpose.presence || "ギフトリスト"), gift_list_path(gift_list), class: "hover:underline" %>
    </h2>
  </div>

  <% if gift_list.selected? && selected_item %>
    <div class="p-3.5 bg-ash-bg border border-ash-border flex space-x-3 items-center">
      <% if selected_item.display_image_url.present? %>
        <%= image_tag selected_item.display_image_url, class: "w-12 h-12 object-cover border border-ash-border flex-shrink-0" %>
      <% end %>
      <div class="flex-1 min-w-0">
        <span class="text-[10px] text-gold-dark font-en tracking-wider block">SELECTED GIFT</span>
        <p class="text-xs font-serif text-ash-text truncate"><%= selected_item.name %></p>
      </div>
    </div>

    <%= link_to gift_list_path(gift_list), class: "w-full py-2.5 text-white font-serif text-xs tracking-wider shadow-sm btn-gold-subtle transition flex items-center justify-center space-x-1.5" do %>
      <span>選ばれたギフトを見る</span>
      <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
    <% end %>
  <% elsif !gift_list.completed? %>
    <div class="text-xs text-ash-sub font-light leading-relaxed flex justify-between items-center pt-1">
      <span>掲載商品: <%= gift_list.gift_items.size %>点</span>
      <div class="flex items-center space-x-4">
        <button type="button"
          data-controller="clipboard"
          data-clipboard-text-value="<%= shared_gift_list_url(gift_list.public_token) %>"
          data-action="clipboard#copy"
          class="text-gold-dark hover:underline flex items-center space-x-1">
          <i data-lucide="copy" class="w-3.5 h-3.5"></i>
          <span>共有URLをコピー</span>
        </button>
        <%= link_to gift_list_path(gift_list), class: "text-gold-dark hover:underline flex items-center space-x-1" do %>
          <i data-lucide="eye" class="w-3.5 h-3.5"></i>
          <span>カタログの中を見る</span>
        <% end %>
      </div>
    </div>
  <% end %>
</article>
